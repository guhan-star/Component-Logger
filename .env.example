# ============================================================
# STARK INDUSTRIES WMC — ENVIRONMENT CONFIGURATION
# ============================================================

# Database Connection (Supabase PostgreSQL)
# Transaction Pooler URL (for application queries - port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (for Prisma migrations - port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Authentication Secret (Must be minimum 32 characters in production)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-random-key-at-least-32-characters-long"

# Application URL (Used for email verification and password recovery links)
APP_URL="https://component-logger.vercel.app"
NEXT_PUBLIC_APP_NAME="Stark Industries WMC"
NEXT_PUBLIC_APP_VERSION="2.2.0"

# Distributed Rate Limiting (Required for Production: Upstash Redis REST API)
# In production, sensitive auth and abuse-prone endpoints fail-closed (HTTP 503) if Upstash is unconfigured.
# In development/test, automatically falls back to an in-memory sliding window limiter.
UPSTASH_REDIS_REST_URL="https://[endpoint].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Transactional Email Provider (Resend REST API - https://resend.com)
# Required for sending real email verification and password reset emails.
# If unconfigured in development/test, emails are simulated and logged to console.
RESEND_API_KEY="re_123456789abcdef"
EMAIL_FROM="Stark Industries WMC <onboarding@resend.dev>"

# Supabase Storage Configuration (Private Buckets: avatars, component-images, receipts, datasheets, project-attachments)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
